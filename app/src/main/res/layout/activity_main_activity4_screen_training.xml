<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09E3FF"
    tools:context=".MainActivity4ScreenTraining">

    <ImageView
        android:id="@+id/btn_time_consult"
        android:layout_width="70dp"
        android:layout_height="37dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_lock_idle_alarm"
        tools:layout_gravity="right" />

    <TextView
        android:id="@+id/texteditar"
        android:layout_width="57dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:text=" Editar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_update_entrena" />

    <ImageView
        android:id="@+id/btn_update_entrena"
        android:layout_width="70dp"
        android:layout_height="37dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_edit"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textaviso"
        android:layout_width="100dp"
        android:layout_height="23dp"
        android:layout_marginEnd="2dp"
        android:text="Horas de aviso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_time_consult" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="2dp"
        android:background="#09E3FF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_activity4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Tu entrenamiento"
                android:textColor="#8F58F1"
                android:textSize="24sp"
                android:textStyle="italic"
                android:visibility="visible" />

            <TextView
                android:id="@+id/nick_sport2"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:textAlignment="center"
                android:textColor="#F85B2A"
                android:textSize="20sp"
                tools:layout_gravity="center"
                tools:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/nick_image_depor2"
                android:layout_width="323dp"
                android:layout_height="148dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/fotodepor2" />

            <TextView
                android:id="@+id/texthoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horas a realizar:" />

            <TextView
                android:id="@+id/nick_hours2"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:textColor="#81817B"
                android:textSize="20sp"
                tools:layout_gravity="right"
                tools:textStyle="bold" />
            <TextView
                android:id="@+id/textdescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu descripción del entrenamiento:" />

            <TextView
                android:id="@+id/nick_desc2"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:textColor="#81817B"
                android:textSize="20sp"
                tools:layout_gravity="right"
                tools:textStyle="bold" />


            <TextView
                android:id="@+id/textday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Día de la semana:" />

            <TextView
                android:id="@+id/nick_day2"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:textAlignment="center"
                android:textColor="#81817B"
                android:textSize="20sp"
                tools:layout_gravity="right"
                tools:textStyle="bold" />

            <Button
                android:id="@+id/btn_plan_consult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="100dp"
                android:layout_marginRight="10dp"
                android:text="Consulta el plan" />


        </LinearLayout>
    </ScrollView>




</androidx.constraintlayout.widget.ConstraintLayout>

