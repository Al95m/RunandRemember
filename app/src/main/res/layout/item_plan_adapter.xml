<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardselect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <ImageView
                android:id="@+id/nick_image_plan"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:foreground="@android:drawable/ic_menu_agenda"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/nick_plan2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/nick_image_plan"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/nick_image_plan"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold" />

            <View
                android:id="@+id/linea"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_above="@+id/btn_del3_entre"
                android:layout_alignStart="@+id/nick_plan2"
                android:layout_alignParentEnd="true"
                android:background="#ffd5d5d5" />

            <ImageView
                android:id="@+id/btn_del3_entre"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_below="@+id/nick_plan2"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:background="@color/purple_700"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_delete" />

            <ImageView
                android:id="@+id/btn_edit3_entre"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignTop="@+id/btn_del3_entre"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/btn_del3_entre"
                android:background="@color/purple_700"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_edit" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
